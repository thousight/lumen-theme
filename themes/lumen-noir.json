{
  "name": "Lumen Dark (Noir)",
  "type": "dark",
  "colors": {
    "activityBar.background": "#26251e",
    "activityBar.foreground": "#e0e0e0",
    "activityBar.border": "#3a3933",
    "sideBar.background": "#26251e",
    "sideBar.foreground": "#e0e0e0",
    "sideBar.border": "#3a3933",
    "sideBarSectionHeader.background": "#26251e",
    "sideBarSectionHeader.foreground": "#e0e0e0",
    "sideBarSectionHeader.border": "#3a3933",
    "editor.background": "#26251e",
    "editor.foreground": "#e0e0e0",
    "editorGroup.border": "#3a3933",
    "editorGroupHeader.tabsBackground": "#26251e",
    "editorGroupHeader.tabsBorder": "#3a3933",
    "tab.activeBackground": "#26251e",
    "tab.activeForeground": "#e0e0e0",
    "tab.inactiveBackground": "#26251e",
    "tab.inactiveForeground": "#a0a0a0",
    "tab.border": "#3a3933",
    "panel.background": "#26251e",
    "panel.border": "#3a3933",
    "statusBar.background": "#26251e",
    "statusBar.foreground": "#e0e0e0",
    "statusBar.border": "#3a3933",
    "titleBar.activeBackground": "#26251e",
    "titleBar.activeForeground": "#e0e0e0",
    "titleBar.inactiveBackground": "#26251e",
    "breadcrumb.background": "#26251e",
    "breadcrumb.foreground": "#a0a0a0",
    "editorCursor.foreground": "#e0e0e0",
    "editor.selectionBackground": "#ffffff22",
    "editor.findMatchBackground": "#f54e00",
    "editor.findMatchHighlightBackground": "#f54e0044",
    "button.background": "#f54e00",
    "button.foreground": "#ffffff",
    "progressBar.background": "#f54e00",
    "list.hoverBackground": "#ffffff11",
    "list.activeSelectionBackground": "#ffffff22",
    "list.inactiveSelectionBackground": "#ffffff11",
    "editorLineNumber.foreground": "#606060",
    "editorLineNumber.activeForeground": "#e0e0e0",
    "editorIndentGuide.background": "#ffffff11",
    "editorIndentGuide.activeBackground": "#ffffff22",
    "terminal.background": "#26251e",
    "editorBracketHighlight.foreground1": "#f54e00",
    "editorBracketHighlight.foreground2": "#7eb6f6",
    "editorBracketHighlight.foreground3": "#99c794",
    "editorBracketHighlight.foreground4": "#c594c5",
    "editorBracketHighlight.foreground5": "#e0e0e0",
    "editorBracketHighlight.foreground6": "#808080",
    "widget.shadow": "#00000000",
    "gitDecoration.modifiedResourceForeground": "#ebcb8b",
    "gitDecoration.deletedResourceForeground": "#bf616a",
    "gitDecoration.addedResourceForeground": "#a3be8c",
    "breadcrumb.activeSelectionForeground": "#f54e00",
    "errorLens.errorBackground": "#bf616a22",
    "errorLens.errorForeground": "#f54e00",
    "errorLens.warningBackground": "#ebcb8b22",
    "errorLens.warningForeground": "#ebcb8b",
    "errorLens.infoBackground": "#81a1c122",
    "errorLens.infoForeground": "#7eb6f6",
    "gitlens.gutterBackgroundColor": "#26251e",
    "gitlens.gutterAddedForegroundColor": "#a3be8c",
    "gitlens.gutterModifiedForegroundColor": "#ebcb8b",
    "gitlens.gutterDeletedForegroundColor": "#bf616a",
    "terminal.ansiBlack": "#26251e",
    "terminal.ansiRed": "#bf616a",
    "terminal.ansiGreen": "#a3be8c",
    "terminal.ansiYellow": "#ebcb8b",
    "terminal.ansiBlue": "#81a1c1",
    "terminal.ansiMagenta": "#b48ead",
    "terminal.ansiCyan": "#88c0d0",
    "terminal.ansiWhite": "#e0e0e0",
    "terminal.ansiBrightBlack": "#4c566a",
    "terminal.ansiBrightRed": "#bf616a",
    "terminal.ansiBrightGreen": "#a3be8c",
    "terminal.ansiBrightYellow": "#ebcb8b",
    "terminal.ansiBrightBlue": "#81a1c1",
    "terminal.ansiBrightMagenta": "#b48ead",
    "terminal.ansiBrightCyan": "#8fbcbb",
    "terminal.ansiBrightWhite": "#eceff4"
  },
  "tokenColors": [
    {
      "scope": [
        "keyword.control",
        "keyword.control.flow",
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword.control.import",
        "keyword.control.from",
        "keyword.control.trycatch",
        "storage.type",
        "storage.modifier",
        "entity.name.tag",
        "punctuation.definition.tag",
        "punctuation.definition.template-expression.begin",
        "punctuation.definition.template-expression.end",
        "punctuation.section.embedded",
        "punctuation.definition.variable.php",
        "punctuation.definition.variable.shell",
        "punctuation.section.bracket.shell"
      ],
      "settings": {
        "foreground": "#f54e00"
      }
    },
    {
      "scope": [
        "variable.function",
        "entity.name.function",
        "meta.function-call",
        "support.function",
        "entity.name.function.preprocessor",
        "keyword.other.special-method",
        "punctuation.definition.macro.rust",
        "entity.name.function.macro.rust"
      ],
      "settings": {
        "foreground": "#7eb6f6"
      }
    },
    {
      "scope": [
        "string",
        "punctuation.definition.string",
        "punctuation.definition.string.begin",
        "punctuation.definition.string.end"
      ],
      "settings": {
        "foreground": "#99c794"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other",
        "variable.other.constant",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#c594c5"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#909090"
      }
    },
    {
      "scope": [
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.bracket",
        "punctuation.section",
        "meta.brace",
        "meta.bracket",
        "meta.paren",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#a0a0a0"
      }
    },
    {
      "scope": [
        "meta.decorator",
        "punctuation.decorator",
        "storage.type.annotation",
        "entity.name.type.annotation",
        "meta.attribute.rust"
      ],
      "settings": {
        "foreground": "#909090"
      }
    },
    {
      "scope": [
        "entity.name.section.markdown",
        "punctuation.definition.heading.markdown"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#f54e00"
      }
    },
    {
      "scope": [
        "punctuation.definition.list.begin.markdown",
        "markup.list.numbered.markdown",
        "markup.list.unnumbered.markdown"
      ],
      "settings": {
        "foreground": "#7eb6f6"
      }
    },
    {
      "scope": [
        "markup.quote.markdown",
        "punctuation.definition.quote.begin.markdown"
      ],
      "settings": {
        "foreground": "#99c794"
      }
    },
    {
      "scope": [
        "markup.inline.raw.markdown",
        "markup.fenced_code.block.markdown",
        "punctuation.definition.raw.markdown"
      ],
      "settings": {
        "foreground": "#c594c5"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#f54e00"
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "function": "#7eb6f6",
    "method": "#7eb6f6",
    "macro": "#7eb6f6",
    "variable.readonly": "#e0e0e0",
    "property.readonly": "#e0e0e0",
    "parameter": "#ce9178",
    "typeParameter": "#e0e0e0",
    "namespace": "#e0e0e0"
  }
}
